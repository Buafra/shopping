# All optional — defaults in app/config.py are sensible.

# Networking
REQUEST_TIMEOUT=20
BROWSER_TIMEOUT=35
MAX_RETRIES=2
PER_STORE_RESULTS=6

# Set this if storefronts block your IP (cloud VMs are blocked often).
# SCRAPER_PROXY=http://user:pass@host:port

# Playwright fallback for JS-rendered / bot-protected stores
USE_BROWSER_FALLBACK=true
# CHROMIUM_PATH=/opt/pw-browsers/chromium

# UAE landed-cost assumptions
UAE_VAT_RATE=0.05
UAE_CUSTOMS_RATE=0.05
UAE_DUTY_FREE_THRESHOLD_AED=300

# Ranking weights — must sum to 1.0
W_PRICE=0.45
W_RATING=0.22
W_REVIEWS=0.13
W_DELIVERY=0.12
W_TRUST=0.08
